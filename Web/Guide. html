<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CyberShield AI — Guide</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #050912;
            --bg-secondary: #080f1d;
            --card: #101a2a;
            --card-light: #142238;
            --border: #1e3554;

            --royal-blue: #4169e1;
            --royal-blue-dark: #3154c6;
            --blue-light: #6d8cff;
            --blue-glow: rgba(65, 105, 225, 0.35);

            --white: #f5f8ff;
            --text: #d9e3f5;
            --muted: #8293ad;

            --success: #42d392;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--white);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* =========================
           NAVBAR
        ========================== */

        nav {
            height: 70px;
            width: 100%;
            background: rgba(5, 9, 18, 0.95);
            border-bottom: 1px solid var(--border);

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 5%;
            position: sticky;
            top: 0;
            z-index: 1000;

            backdrop-filter: blur(12px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;

            background: linear-gradient(
                135deg,
                var(--royal-blue),
                #2747a9
            );

            display: flex;
            align-items: center;
            justify-content: center;

            box-shadow: 0 0 18px var(--blue-glow);
        }

        .brand-icon::before {
            content: "🛡";
            font-size: 17px;
        }

        .brand span {
            color: white;
        }

        .brand span:last-child {
            color: var(--blue-light);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--muted);
            font-size: 13px;
            transition: 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--blue-light);
        }

        .nav-button {
            background: var(--royal-blue);
            color: white !important;

            padding: 10px 18px;
            border-radius: 8px;

            font-weight: 600;

            box-shadow: 0 5px 18px rgba(65, 105, 225, 0.3);
        }

        .nav-button:hover {
            background: var(--royal-blue-dark);
            transform: translateY(-1px);
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            min-height: 430px;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            text-align: center;

            padding: 80px 20px;

            background:
                radial-gradient(
                    circle at center,
                    rgba(65, 105, 225, 0.12),
                    transparent 45%
                ),
                linear-gradient(
                    rgba(5, 9, 18, 0.95),
                    rgba(5, 9, 18, 1)
                );

            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(65, 105, 225, 0.04) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(65, 105, 225, 0.04) 1px,
                    transparent 1px
                );

            background-size: 45px 45px;
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .eyebrow {
            display: inline-block;

            border: 1px solid rgba(65, 105, 225, 0.5);
            background: rgba(65, 105, 225, 0.1);

            color: var(--blue-light);

            padding: 7px 17px;
            border-radius: 30px;

            font-size: 11px;
            font-weight: bold;

            letter-spacing: 1.5px;

            margin-bottom: 22px;
        }

        h1 {
            font-size: clamp(38px, 6vw, 68px);
            line-height: 1.05;
            margin-bottom: 22px;

            font-weight: 800;
        }

        h1 span {
            color: var(--blue-light);
            text-shadow: 0 0 25px rgba(65, 105, 225, 0.35);
        }

        .hero p {
            max-width: 650px;
            color: var(--muted);
            font-size: 15px;
            margin: auto;
        }

        .hero-buttons {
            margin-top: 30px;

            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* =========================
           BUTTONS
        ========================== */

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 13px 25px;

            border-radius: 9px;

            font-size: 13px;
            font-weight: 700;

            text-decoration: none;
            cursor: pointer;

            transition: 0.3s;
        }

        .btn-primary {
            background: var(--royal-blue);
            color: white;

            border: 1px solid var(--royal-blue);

            box-shadow:
                0 8px 25px rgba(65, 105, 225, 0.28);
        }

        .btn-primary:hover {
            background: var(--royal-blue-dark);
            box-shadow:
                0 10px 30px rgba(65, 105, 225, 0.45);

            transform: translateY(-2px);
        }

        .btn-secondary {
            background: rgba(13, 24, 41, 0.7);
            color: var(--text);

            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            border-color: var(--royal-blue);
            color: var(--blue-light);
        }

        /* =========================
           VIDEO SECTION
        ========================== */

        .video-section {
            width: min(900px, 92%);
            margin: 35px auto 70px;
        }

        .video-container {
            border: 1px solid var(--border);
            background: #03060d;

            border-radius: 14px;
            overflow: hidden;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.4);
        }

        .video-top {
            height: 32px;
            padding: 0 14px;

            display: flex;
            align-items: center;
            gap: 6px;

            border-bottom: 1px solid #17243a;
            color: #51627c;

            font-size: 11px;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #34445d;
        }

        .video-area {
            height: 400px;

            display: flex;
            justify-content: center;
            align-items: center;

            background:
                radial-gradient(
                    circle,
                    rgba(65, 105, 225, 0.08),
                    transparent 50%
                );
        }

        .play-button {
            width: 65px;
            height: 65px;

            border-radius: 50%;

            border: 1px solid rgba(65, 105, 225, 0.7);

            background: rgba(65, 105, 225, 0.12);

            color: white;

            font-size: 24px;

            cursor: pointer;

            box-shadow:
                0 0 30px rgba(65, 105, 225, 0.25);

            transition: 0.3s;
        }

        .play-button:hover {
            background: var(--royal-blue);
            transform: scale(1.08);
        }

        .video-info {
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            margin-top: 12px;
        }

        .video-controls {
            height: 48px;

            display: flex;
            align-items: center;
            gap: 14px;

            padding: 0 15px;

            border-top: 1px solid #17243a;
        }

        .control-play {
            width: 24px;
            height: 24px;

            border: 0;
            border-radius: 6px;

            background: var(--royal-blue);
            color: white;

            cursor: pointer;
        }

        .progress {
            height: 3px;
            flex: 1;

            background: #26344b;
            border-radius: 5px;
        }

        .quality {
            padding: 5px 8px;

            border-radius: 5px;

            background: #121d2e;
            color: #8190a7;

            font-size: 10px;
        }

        /* =========================
           GUIDE
        ========================== */

        .guide-section {
            width: min(900px, 92%);
            margin: auto;
        }

        .section-label {
            color: var(--blue-light);
            font-size: 10px;
            letter-spacing: 1.5px;
            font-weight: 700;

            margin-bottom: 8px;
        }

        .section-title {
            font-size: 25px;
            margin-bottom: 25px;
        }

        /* =========================
           ACCORDION
        ========================== */

        .accordion {
            border: 1px solid var(--border);

            background: var(--card);

            border-radius: 11px;

            margin-bottom: 10px;

            overflow: hidden;

            transition: 0.3s;
        }

        .accordion:hover {
            border-color: rgba(65, 105, 225, 0.5);
        }

        .accordion-header {
            padding: 18px 20px;

            display: flex;
            align-items: center;

            cursor: pointer;
        }

        .step-number {
            width: 32px;
            height: 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(65, 105, 225, 0.1);

            color: var(--blue-light);

            border-radius: 7px;

            margin-right: 14px;

            font-size: 11px;
            font-weight: 700;
        }

        .step-title {
            flex: 1;
        }

        .step-title strong {
            display: block;
            font-size: 14px;
        }

        .step-title small {
            color: var(--muted);
            font-size: 10px;
        }

        .arrow {
            color: var(--blue-light);
            transition: 0.3s;
        }

        .accordion.active .arrow {
            transform: rotate(180deg);
        }

        .accordion-content {
            display: none;

            padding: 0 20px 25px;

            color: var(--muted);
            font-size: 12px;

            border-top: 1px solid rgba(65, 105, 225, 0.08);
        }

        .accordion.active .accordion-content {
            display: block;
        }

        .content-grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 25px;

            padding-top: 20px;
        }

        .content-grid h4 {
            color: white;
            margin-bottom: 12px;
        }

        .content-grid ul {
            padding-left: 18px;
        }

        .content-grid li {
            margin-bottom: 7px;
        }

        .mock-screen {
            border: 1px solid var(--border);

            border-radius: 9px;

            padding: 18px;

            background: #080e19;
        }

        .mock-title {
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 14px;
        }

        .mock-input {
            height: 34px;

            background: #0d1726;

            border: 1px solid #263b59;

            border-radius: 6px;

            margin-bottom: 10px;

            padding: 8px;

            color: #66758d;

            font-size: 10px;
        }

        .mock-button {
            width: 100%;

            padding: 10px;

            border: 0;
            border-radius: 6px;

            background: var(--royal-blue);

            color: white;

            font-size: 10px;
            font-weight: bold;
        }

        /* =========================
           FAQ
        ========================== */

        .faq-section {
            width: min(900px, 92%);
            margin: 70px auto;
        }

        .faq-item {
            border: 1px solid var(--border);

            background: var(--card);

            border-radius: 10px;

            margin-bottom: 9px;

            overflow: hidden;
        }

        .faq-question {
            padding: 17px 20px;

            display: flex;
            justify-content: space-between;

            cursor: pointer;

            font-size: 12px;
            font-weight: 600;
        }

        .faq-question span {
            color: var(--blue-light);
            font-size: 18px;
        }

        .faq-answer {
            display: none;

            padding: 0 20px 18px;

            color: var(--muted);

            font-size: 11px;
        }

        .faq-item.active .faq-answer {
            display: block;
        }

        /* =========================
           CTA
        ========================== */

        .cta {
            width: min(900px, 92%);

            margin: 30px auto 80px;

            padding: 55px 25px;

            text-align: center;

            background:
                radial-gradient(
                    circle at center,
                    rgba(65, 105, 225, 0.12),
                    transparent 60%
                ),
                var(--card);

            border: 1px solid var(--border);

            border-radius: 15px;
        }

        .shield-icon {
            font-size: 45px;

            margin-bottom: 15px;

            filter:
                drop-shadow(
                    0 0 15px rgba(65, 105, 225, 0.5)
                );
        }

        .cta h2 {
            font-size: 27px;
            margin-bottom: 10px;
        }

        .cta p {
            color: var(--muted);
            font-size: 12px;
            margin-bottom: 25px;
        }

        /* =========================
           BOTTOM NAV
        ========================== */

        .bottom-nav {
            position: fixed;

            bottom: 18px;
            left: 50%;

            transform: translateX(-50%);

            display: flex;

            background: rgba(10, 18, 31, 0.95);

            border: 1px solid var(--border);

            border-radius: 30px;

            padding: 6px;

            z-index: 100;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.4);

            backdrop-filter: blur(12px);
        }

        .bottom-nav a {
            padding: 9px 16px;

            color: var(--muted);

            text-decoration: none;

            font-size: 10px;

            border-radius: 20px;

            transition: 0.3s;
        }

        .bottom-nav a:hover {
            color: white;
        }

        .bottom-nav a.active {
            background: var(--royal-blue);
            color: white;

            box-shadow:
                0 4px 15px rgba(65, 105, 225, 0.35);
        }

        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 700px) {

            nav {
                padding: 0 18px;
            }

            .nav-links {
                gap: 12px;
            }

            .nav-links a:not(.nav-button) {
                display: none;
            }

            .hero {
                min-height: 400px;
                padding: 65px 20px;
            }

            h1 {
                font-size: 42px;
            }

            .video-area {
                height: 240px;
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .bottom-nav {
                width: auto;
                max-width: 95%;
            }

            .bottom-nav a {
                padding: 8px 10px;
                font-size: 9px;
            }

            .cta {
                margin-bottom: 100px;
            }
        }
    </style>
</head>

