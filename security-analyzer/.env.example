# CyberShield AI — Security Analyzer
# Copy this file to .env and fill in the values.

# Port the service listens on (default 5050)
ANALYZER_PORT=5050

# No API key needed! The service uses:
#   - HIBP Pwned Passwords (free k-anonymity API, no key) for password breach checks
#   - XposedOrNot (free, no key) for email/domain leak scanning
